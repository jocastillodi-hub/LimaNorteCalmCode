# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local a Git.

# Clave de la API de Anthropic. Solo se usa en el servidor (route handler /api/chat).
# Si no se define, el asistente funciona en MODO DEMOSTRATIVO (sin IA externa).
ANTHROPIC_API_KEY=

# Modelo a usar. Por defecto: claude-haiku-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# Supabase (alias anónimo). La clave anon es pública por diseño: la seguridad la dan las políticas RLS
# de supabase/usuarios_anonimos.sql. Sin estas variables, la pantalla de bienvenida no puede crear refugios.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Datos de apoyo psicológico UCV. Déjalos vacíos hasta verificar el canal oficial.
# Solo variables NEXT_PUBLIC_ porque se muestran en el navegador (no son secretas).
NEXT_PUBLIC_UCV_PSICOLOGIA_URL=
NEXT_PUBLIC_UCV_PSICOLOGIA_CONTACTO=
# Número o instrucción de emergencia de tu país/ubicación. Pendiente de confirmar.
NEXT_PUBLIC_EMERGENCIA_CONTACTO=
